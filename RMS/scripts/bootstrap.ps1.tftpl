#ps1_sysnative
$ErrorActionPreference = 'Stop'
$bootstrapStartedUtc = [DateTime]::UtcNow.ToString('o')
$bootstrapWatch = [Diagnostics.Stopwatch]::StartNew()
$root = Join-Path $env:ProgramData 'OCI-ADJoin'
New-Item -ItemType Directory -Path $root -Force | Out-Null
# Remove inherited access before writing any files executed as SYSTEM.
& icacls.exe $root /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null
if ($LASTEXITCODE -ne 0) { throw 'Cannot secure bootstrap directory.' }
function Write-BootstrapFile([string]$Name, [string]$Payload) {
    $inputStream = [IO.MemoryStream]::new([Convert]::FromBase64String($Payload))
    $gzip = $null
    $outputStream = $null
    try {
        $gzip = [IO.Compression.GZipStream]::new($inputStream, [IO.Compression.CompressionMode]::Decompress)
        $outputStream = [IO.File]::Create((Join-Path $root $Name))
        $gzip.CopyTo($outputStream)
    } finally {
        if ($outputStream) { $outputStream.Dispose() }
        if ($gzip) { $gzip.Dispose() }
        $inputStream.Dispose()
    }
}
[IO.File]::WriteAllBytes((Join-Path $root 'config.json'), [Convert]::FromBase64String('${config_base64}'))
Write-BootstrapFile 'join-domain.ps1' '${worker_base64}'
Write-BootstrapFile 'read_secret.py' '${helper_base64}'
Write-BootstrapFile 'cleanup_access.py' '${cleanup_base64}'
Write-BootstrapFile 'stage_logging.ps1' '${logging_base64}'
$action = New-ScheduledTaskAction -Execute "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -Argument ('-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + $root + '\join-domain.ps1"')
$firstRun = (Get-Date).AddMinutes(5)
$timer = New-ScheduledTaskTrigger -Once -At $firstRun -RepetitionInterval (New-TimeSpan -Minutes 5) -RepetitionDuration (New-TimeSpan -Days 1)
$startup = New-ScheduledTaskTrigger -AtStartup
$principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
$settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Minutes 15)
Register-ScheduledTask -TaskName 'OCI-ADJoin' -Action $action -Trigger @($timer, $startup) -Principal $principal -Settings $settings -Force | Out-Null
# Cloudbase-Init must finish before a separate process attempts the join/reboot.
@{ state = 'scheduled'; updated_utc = [DateTime]::UtcNow.ToString('o') } | ConvertTo-Json | Set-Content (Join-Path $root 'status.json') -Encoding UTF8
$bootstrapWatch.Stop()
@{
    event = 'bootstrap_scheduled'
    timestamp_utc = [DateTime]::UtcNow.ToString('o')
    started_utc = $bootstrapStartedUtc
    duration_ms = [Math]::Round($bootstrapWatch.Elapsed.TotalMilliseconds, 3)
    first_run_utc = $firstRun.ToUniversalTime().ToString('o')
} | ConvertTo-Json -Compress | Add-Content (Join-Path $root 'timings.jsonl') -Encoding UTF8
